# ── Android Release Signing & Local Config (NEVER commit these) ─────────────
# Committing the keystore or key.properties would allow anyone with repo access
# to sign and publish fake updates to your Play Store listing.
**/android/local.properties
**/android/.gradle/
.gradle/
android/key.properties
*.jks
*.keystore
android/app/*.jks
android/app/*.keystore

